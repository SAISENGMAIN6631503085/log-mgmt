# Single entry point for the whole system; the only service with published HTTP ports.
{$SITE_ADDRESS:localhost} {
	# "internal" = self-signed (appliance); an email address = Let's Encrypt (SaaS)
	tls {$CADDY_TLS:internal}

	encode gzip

	# Internal endpoint for Vector only (it talks to ingest:8080 directly on the Docker
	# network). Refuse it from outside so nobody can inject syslog into any tenant.
	# (A handle block, not a bare `respond`: Caddy runs `handle` before `respond`, so a bare
	# respond would never be reached for paths the handles below also match.)
	@internal path /api/ingest/syslog
	handle @internal {
		respond 404
	}

	# Upload limit (matches MaxUploadBytes in the ingest service, plus multipart overhead).
	request_body {
		max_size 55MB
	}

	# Logs coming in go to the Go ingest service. Handles with named matchers are tried in the
	# order written, so this one must stay above the /api/* handle below.
	@ingest path /ingest /api/ingest /api/ingest/*
	handle @ingest {
		reverse_proxy ingest:8080
	}

	# The Python backend owns the rest of /api/*, /health and the interactive API docs;
	# everything else is the React SPA.
	@backend path /api/* /health /docs /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
