# Copy to .env and change the secrets. .env is git-ignored; never commit it.

# --- PostgreSQL ---
POSTGRES_USER=logmgmt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logmgmt
# Host/port as seen from the backend container (service name on the compose network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
# Secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Tenant assigned to syslog events whose sender IP is not mapped to a tenant
DEFAULT_TENANT=demoA
# Days of event partitions to keep before the retention job drops them
RETENTION_DAYS=7
# Optional: alerts are POSTed as JSON here when set
ALERT_WEBHOOK_URL=

# --- Caddy / TLS ---
# Appliance mode: "localhost" (or the VM's hostname/IP).
# SaaS mode: your public DNS name, e.g. logs.example.com
SITE_ADDRESS=localhost
# Appliance mode: "internal" = Caddy's self-signed local CA.
# SaaS mode: an email address, which makes Caddy obtain a Let's Encrypt certificate.
CADDY_TLS=internal
