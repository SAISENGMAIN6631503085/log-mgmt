# Copy to .env and change the secrets. .env is git-ignored; never commit it.

# --- PostgreSQL ---
POSTGRES_USER=logmgmt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=logmgmt
# Host/port as seen from the backend and ingest containers (service name on the compose network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- ClickHouse (event store) ---
# Logs live in ClickHouse; Postgres keeps users, keys, alerts and settings. Not reachable from outside.
CLICKHOUSE_DB=logmgmt
CLICKHOUSE_USER=logmgmt
CLICKHOUSE_PASSWORD=change-me
# Host/port as seen from the backend and ingest containers
CLICKHOUSE_URL=http://clickhouse:8123

# --- Backend and ingest ---
# Secret for signing login tokens (the backend signs them; the ingest service checks them for
# website uploads). Generate with: openssl rand -hex 32
# Must be at least 32 characters; both services refuse to start with this placeholder.
JWT_SECRET=change-me-to-a-long-random-string
# How long a login token is valid
JWT_EXPIRE_MINUTES=480
# (ingest) Tenant assigned to syslog events whose sender IP is not mapped to a tenant
DEFAULT_TENANT=demoA
# (ingest) Syslog has no tenant field, so it is picked by sender IP: "network=tenant" pairs, comma-separated.
# The most specific match wins; unmatched senders get DEFAULT_TENANT.
SYSLOG_TENANT_MAP=10.0.1.0/24=demoA,10.0.2.0/24=demoB
# Shared secret Vector sends to the internal syslog endpoint. Generate with: openssl rand -hex 32
SYSLOG_INGEST_TOKEN=change-me-to-a-long-random-string
# Demo ingest API keys created by `make seed`, as "tenant=key" pairs. Send as the X-API-Key header.
SEED_API_KEYS=demoA=lm_demoA_dev_key_change_me,demoB=lm_demoB_dev_key_change_me
# Demo users created by `make seed`: admin (all tenants), viewerA (demoA), viewerB (demoB)
SEED_ADMIN_PASSWORD=change-me-admin
SEED_VIEWER_PASSWORD=change-me-viewer
# Days of events to keep before the retention job drops them
RETENTION_DAYS=7
# Optional: alerts are POSTed as JSON here when set (e.g. a Slack/Teams/webhook.site URL)
ALERT_WEBHOOK_URL=
# How often the alert worker runs
ALERT_INTERVAL_SECONDS=60
# Sign-in throttling: this many failed sign-ins within LOGIN_LOCK_MINUTES locks that account
# (counted per typed username) or that client address, until the window has passed.
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_LOCK_MINUTES=5

# --- Syslog (Vector) ---
# Address Vector's port 514 is published on. 0.0.0.0 = reachable from the network (appliance on a LAN).
# SaaS: 127.0.0.1 (off), unless the cloud firewall only lets your devices' IPs reach 514.
SYSLOG_BIND=0.0.0.0

# --- Demo traffic ---
# "demo" also starts the simulator service: live events for demoA/demoB and an attack every
# 15 minutes, so a public demo always has fresh data. The website then shows a "Demo data" label.
# Leave empty on a real install.
COMPOSE_PROFILES=

# --- Country lookup (GeoIP) ---
# Path of the DB-IP country database inside the backend and ingest images; it's downloaded at build time.
# Only change this if you mount your own .mmdb file.
GEOIP_DB=/app/geoip/dbip-country-lite.mmdb

# --- Caddy / TLS ---
# Appliance mode: "localhost" (or the VM's hostname/IP).
# SaaS mode: your public DNS name, e.g. logs.example.com
SITE_ADDRESS=localhost
# Appliance mode: "internal" = Caddy's self-signed local CA.
# SaaS mode: an email address, which makes Caddy obtain a Let's Encrypt certificate.
CADDY_TLS=internal
